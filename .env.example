# Runtime: Node.js 22.13+. Hosted PostgreSQL (Neon, Supabase, or another provider).
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique value (32+ characters); never commit the real secret.
BETTER_AUTH_SECRET=
ADMIN_EMAIL=digitalmarketingnp0@gmail.com

# Google OAuth web application credentials (server-only).
# Callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Six-digit signup verification codes and password recovery (server-only).
# Resend: verify digitalmarketingnp.me (or a mail subdomain), then create a sending key.
# AUTH_EMAIL_FROM example: Digital Marketing NP <accounts@digitalmarketingnp.me>
# In Vercel use Secret for RESEND_API_KEY; Config for AUTH_EMAIL_FROM; then redeploy.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Automatic provider fulfillment. Add the key as a Secret in Vercel Production.
SUVAKRIO_API_KEY=
SERVICE_MARKUP_PERCENT=75
# Daily Vercel backup for queued orders/status refresh. Use a random 32+ character Secret.
CRON_SECRET=
# Optional emergency switch: manual disables provider requests and automatic pricing.
# FULFILLMENT_MODE=manual

# Public storefront contacts (no secrets).
NEXT_PUBLIC_WHATSAPP_NUMBER=9779744505435
NEXT_PUBLIC_ESEWA_ID=
NEXT_PUBLIC_ESEWA_QR_URL=/esewa-qr.jpg

# Optional Search Console HTML verification token (public, not an OAuth credential).
# Domain-property DNS verification does not require this variable.
GOOGLE_SITE_VERIFICATION=
