# Runtime: Node.js 22.13+; use a persistent local volume for SQLite.
DATABASE_PATH=.runtime/digitalmarketing.sqlite
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique value (32+ characters); never commit the real secret.
BETTER_AUTH_SECRET=
ADMIN_EMAIL=digitalmarketingnp0@gmail.com

# Google OAuth web application credentials (server-only).
# Callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification and password recovery (server-only).
# Configure a verified sender before enabling production email registration.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Provider fulfillment is manual until real service IDs/API integration are configured.
SUVAKRIO_API_KEY=
SERVICE_MARKUP_PERCENT=75

# Public storefront contacts (no secrets).
NEXT_PUBLIC_WHATSAPP_NUMBER=9779744505435
NEXT_PUBLIC_ESEWA_ID=
NEXT_PUBLIC_ESEWA_QR_URL=/esewa-qr.jpg
